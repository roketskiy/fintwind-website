---
import Icon from '../components/Icon.astro';
import Screenshot from '../components/Screenshot.astro';
import appIconUrl from '../../assets/icons/fintwind-logo.svg?url';
import { gallery, questions, repository, release, version, downloadRoot } from '../data/product';
import '@fontsource-variable/manrope';
import '../styles/site.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const asset = (name: string) => `${base}media/${name}`;
const conversation = gallery[0]!;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>Fintwind | OpenCode 的原生 Windows 客户端</title>
    <meta name="description" content="在 Windows 上使用 OpenCode：管理会话、切换模型、连接 MCP 工具并查看用量。Rust + GPUI 原生渲染，沿用现有配置，免费开源。" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content="Fintwind | OpenCode 的原生 Windows 客户端" />
    <meta property="og:description" content="在一个原生窗口里管理会话、模型和工具。连接本机 OpenCode，沿用你已有的配置。" />
    <link rel="icon" type="image/svg+xml" href={appIconUrl} />
    <link rel="preload" as="image" href={asset('session-demo-poster.webp')} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header">
      <nav class="nav container" aria-label="主导航">
        <a class="brand" href="#main" aria-label="Fintwind 首页">
          <img src={appIconUrl} width="32" height="32" alt="" />
          <span>fintwind</span>
        </a>
        <div class="nav-links">
          <a href="#workspace">功能</a>
          <a href="#native">原生体验</a>
          <a href={repository} target="_blank" rel="noreferrer">GitHub <Icon name="arrowUpRight" /></a>
        </div>
        <div class="nav-actions">
          <a class="button button-small button-solid nav-download" href="#download">下载 Windows 版 <Icon name="arrowRight" /></a>
        </div>
      </nav>
    </header>

    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow"><Icon name="windows" /> 免费开源，为 Windows 构建</p>
          <h1 id="hero-title">OpenCode，<span>原生桌面体验。</span></h1>
          <p class="hero-description">在一个原生窗口里管理会话、模型和工具。<br class="desktop-break" />连接本机 OpenCode，沿用你已有的配置。</p>
          <div class="hero-actions">
            <a class="button button-solid" href="#download"><Icon name="windows" />下载 Windows 版<Icon name="arrowRight" /></a>
            <a class="button button-quiet" href="#workspace">查看功能 <Icon name="arrowRight" /></a>
          </div>
        </div>
        <div class="hero-visual">
          <figure>
            <div class="demo-stage">
              <video id="demo-video" class="demo-video" autoplay muted loop playsinline preload="metadata" poster={asset('session-demo-poster.webp')} data-src={asset('session-demo.mp4')} width="1440" height="856" aria-label="Fintwind 会话操作自动演示" disablepictureinpicture disableRemotePlayback></video>
              <img class="demo-still" src={asset('session-demo-poster.webp')} width="1440" height="856" alt="Fintwind 会话演示静帧" fetchpriority="high" />
            </div>
          </figure>
          <p class="video-error" role="status" hidden>无法播放内嵌视频。<a href={asset('session-demo.mp4')}>打开演示视频</a></p>
          <noscript><p class="noscript-note"><a href={asset('session-demo.mp4')}>打开演示视频</a></p></noscript>
        </div>
      </section>

      <aside class="product-facts container" aria-label="产品概览">
        <div><Icon name="wind" /><p><strong>Rust + GPUI</strong><span>GPU 直接绘制界面</span></p></div>
        <div><Icon name="shield" /><p><strong>本地保存</strong><span>项目、会话与附件存于本机</span></p></div>
        <div><Icon name="code" /><p><strong>免费开源</strong><span>GPL-3.0 许可证</span></p></div>
      </aside>

      <section id="workspace" class="workspace section container" aria-labelledby="workspace-title">
        <div class="section-heading" data-reveal>
          <h2 id="workspace-title">一个窗口，管理编码任务。</h2>
          <p>管理会话、选择模型、连接工具，直接在桌面完成。</p>
        </div>
        <article class="conversation-feature" data-reveal>
          <div class="feature-copy">
            <h3>{conversation.title.split('\n').map(line => <span>{line}</span>)}</h3>
            <p>{conversation.description}</p>
            <ul>{conversation.details.map(detail => <li><Icon name="check" />{detail}</li>)}</ul>
          </div>
          <div class="conversation-screen"><Screenshot {...conversation} /></div>
        </article>
        <div class="feature-gallery">
          {gallery.slice(1).map(item => (
            <article class:list={['feature-card', `feature-card-${item.id}`]} data-reveal>
              <header><h3>{item.title.replace('\n', '')}</h3><p>{item.description}</p></header>
              <div class="feature-screen"><Screenshot {...item} /></div>
            </article>
          ))}
        </div>
        <p class="gallery-caption">当前开发版截图，可放大查看。</p>
      </section>

      <section id="native" class="native-section section container" aria-labelledby="native-title">
        <div class="native-layout">
          <div class="native-copy" data-reveal>
            <Icon name="wind" class="section-symbol" />
            <h2 id="native-title">多个任务，<br />一页一个会话。</h2>
            <p>用标签页并行推进不同任务，切换即达、互不打扰。界面直接在 GPU 上绘制，切到哪一页，长对话都能轻快滚动。</p>
            <a class="text-link" href={`${repository}/blob/main/docs/performance.md`} target="_blank" rel="noreferrer">阅读性能设计 <Icon name="arrowUpRight" /></a>
          </div>
          <div class="native-screen" data-reveal>
            <Screenshot image="tabs" label="会话标签" alt="Fintwind 开发版标签栏，显示多个会话及当前对话记录" width={683} height={547} />
          </div>
        </div>
      </section>

      <section class="ownership section container" aria-labelledby="ownership-title">
        <div class="section-heading" data-reveal>
          <h2 id="ownership-title">自己的模型，自己的数据。</h2>
          <p>继续使用已有的 OpenCode 配置，项目与会话保存在本机。</p>
        </div>
        <div class="principle-grid">
          <article class="principle principle-choice" data-reveal>
            <div class="principle-heading"><Icon name="code" /><h3>配置一次，桌面端继续用。</h3></div>
            <p>CLI 和桌面端共用 OpenCode 配置。供应商、模型和 MCP 服务器，无需再维护一套。</p>
            <div class="config-flow" aria-label="OpenCode 的同一份配置用于 CLI 和 Fintwind">
              <span>OpenCode CLI</span><span class="config-line" aria-hidden="true"></span><strong>同一份配置</strong><span class="config-line" aria-hidden="true"></span><span>fintwind</span>
            </div>
            <a class="text-link" href={`${repository}/blob/main/README.zh-CN.md#环境要求`} target="_blank" rel="noreferrer">查看环境要求 <Icon name="arrowUpRight" /></a>
          </article>
          <article class="principle principle-local" data-reveal>
            <div class="principle-heading"><Icon name="shield" /><h3>对话记录，保存在本机。</h3></div>
            <p>项目、会话和附件本地保存。无需注册 Fintwind 账号，不做云端同步，默认零遥测。</p>
            <div class="local-note"><Icon name="check" /><span>调用模型时，相关内容会发送至你配置的模型供应商。</span></div>
          </article>
        </div>
      </section>

      <section id="download" class="download-section section container" aria-labelledby="download-title">
        <div class="download-heading" data-reveal>
          <h2 id="download-title">安装 Fintwind，<br /><span>开始下一段对话。</span></h2>
          <p>先登录 OpenCode，再打开 Fintwind。选择模型，就可以开始。</p>
        </div>
        <div class="start-grid">
          <div class="download-card" data-reveal>
            <div class="download-platform"><Icon name="windows" /><div><h3>Fintwind for Windows</h3><p>Windows 10 1809+ / Windows 11</p></div></div>
            <fieldset class="architecture" disabled>
              <legend>选择设备架构</legend>
              <label><input type="radio" name="architecture" value="x86_64" checked /><span>x64 <small>Intel / AMD</small></span></label>
              <label><input type="radio" name="architecture" value="aarch64" /><span>ARM64</span></label>
            </fieldset>
            <a id="download-setup" class="button button-solid" href={`${downloadRoot}/fintwind-${version}-x86_64-Setup.exe`} data-download-root={downloadRoot} data-version={version}>下载安装包 <Icon name="arrowRight" /></a>
            <a id="download-portable" class="text-link portable-link" href={`${downloadRoot}/fintwind-${version}-x86_64-pc-windows-msvc.zip`}>下载便携版 ZIP <Icon name="arrowUpRight" /></a>
            <div class="download-meta"><span>v{version}</span><a href={release} target="_blank" rel="noreferrer">版本说明 <Icon name="arrowUpRight" /></a><span>免费开源</span></div>
            <p class="setup-note">使用前需安装并登录兼容版本的 OpenCode CLI。<a href={`${repository}/blob/main/README.zh-CN.md#环境要求`} target="_blank" rel="noreferrer">查看环境要求</a></p>
            <noscript><p class="noscript-note">上方为 x64 下载。ARM64 设备请选择：<a href={`${downloadRoot}/fintwind-${version}-aarch64-Setup.exe`}>下载 ARM64 安装包</a> / <a href={`${downloadRoot}/fintwind-${version}-aarch64-pc-windows-msvc.zip`}>下载 ARM64 便携版</a>。</p></noscript>
          </div>
          <div class="faq" data-reveal>
            <h3>常见问题</h3>
            {questions.map(question => (
              <details>
                <summary>{question.title}<Icon name="caretDown" /></summary>
                <p>{question.answer}</p>
              </details>
            ))}
            <a class="text-link faq-more" href={`${repository}/issues`} target="_blank" rel="noreferrer">在 GitHub 提问 <Icon name="arrowUpRight" /></a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer container">
      <div><a class="brand" href="#main"><img src={appIconUrl} width="32" height="32" alt="" /><span>fintwind</span></a><p>OpenCode 的原生 Windows 客户端。</p></div>
      <div class="footer-links"><a href={repository} target="_blank" rel="noreferrer"><Icon name="github" />源代码</a><a href={`${repository}/blob/main/LICENSE`} target="_blank" rel="noreferrer">GPL-3.0</a><a href="https://github.com/egoist/waku" target="_blank" rel="noreferrer">基于 waku</a></div>
      <p class="footer-note">独立开源项目，非 OpenCode 官方客户端。</p>
    </footer>

    <dialog id="image-dialog" class="media-dialog image-dialog" aria-labelledby="image-title">
      <div class="dialog-heading"><h2 id="image-title">界面原图</h2><button class="icon-button" type="button" data-close-dialog aria-label="关闭原图" autofocus><Icon name="x" /></button></div>
      <img id="expanded-image" alt="" />
    </dialog>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
